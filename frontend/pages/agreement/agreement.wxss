page {
  background: #FFF8F8;
}

.doc-container {
  min-height: 100vh;
  padding: 32rpx 40rpx calc(60rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ===== 标题区 ===== */
.doc-head {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 40rpx 36rpx;
  box-shadow: 0 8rpx 48rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 24rpx;
}

.doc-title {
  display: block;
  font-size: 42rpx;
  font-weight: 700;
  color: #333333;
  text-align: center;
  margin-bottom: 16rpx;
}

.doc-meta {
  display: block;
  font-size: 24rpx;
  color: #999999;
  text-align: center;
  margin-bottom: 28rpx;
}

.doc-intro {
  display: block;
  font-size: 28rpx;
  line-height: 1.8;
  color: #555555;
  text-align: justify;
}

/* ===== 正文 ===== */
.doc-body {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 40rpx 36rpx;
  box-shadow: 0 8rpx 48rpx rgba(0, 0, 0, 0.06);
}

.section {
  margin-bottom: 40rpx;
}

.section:last-child {
  margin-bottom: 0;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 20rpx;
}

.para {
  display: block;
  font-size: 28rpx;
  line-height: 1.8;
  color: #555555;
  text-align: justify;
  margin-bottom: 16rpx;
}

.para:last-child {
  margin-bottom: 0;
}

/* ===== 条目列表 ===== */
.bullet-list {
  margin-bottom: 16rpx;
}

.bullet-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 14rpx;
}

.bullet-dot {
  font-size: 28rpx;
  line-height: 1.8;
  color: var(--primary-color, #FF6B81);
  margin-right: 12rpx;
  flex-shrink: 0;
}

.bullet-text {
  flex: 1;
  font-size: 28rpx;
  line-height: 1.8;
  color: #555555;
  text-align: justify;
}

/* ===== 底部 ===== */
.doc-foot {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.btn-read {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #FF6B81, #E8556B);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 50rpx;
  box-shadow: 0 8rpx 32rpx rgba(255, 107, 129, 0.3);
}

.foot-tip {
  font-size: 22rpx;
  color: #BBBBBB;
  margin-top: 24rpx;
  text-align: center;
  line-height: 1.6;
}