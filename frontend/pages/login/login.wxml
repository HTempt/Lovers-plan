<view class="login-container">
  <view class="login-header">
    <view class="logo-area">
      <text class="logo-heart">💕</text>
      <text class="logo-title">双人岛</text>
      <text class="logo-subtitle">属于我们的秘密花园</text>
    </view>
  </view>

  <view class="login-features">
    <view class="feature-item">
      <text class="feature-icon">📝</text>
      <text class="feature-text">记录恋爱点滴</text>
    </view>
    <view class="feature-item">
      <text class="feature-icon">🎯</text>
      <text class="feature-text">规划共同目标</text>
    </view>
    <view class="feature-item">
      <text class="feature-icon">💕</text>
      <text class="feature-text">共享每日状态</text>
    </view>
  </view>

  <view class="login-footer">
    <!-- 协议勾选：默认不勾选，必须由用户阅读后主动选择 -->
    <view class="agreement-row {{shakeAgreement ? 'shake' : ''}}">
      <view class="checkbox-wrap" bindtap="toggleAgreement">
        <view class="checkbox {{agreed ? 'checked' : ''}}">
          <text class="checkbox-icon" wx:if="{{agreed}}">✓</text>
        </view>
      </view>
      <view class="agreement-text">
        <text class="agreement-plain" bindtap="toggleAgreement">我已阅读并同意</text>
        <text class="agreement-link" catchtap="openAgreement" data-type="user">《用户服务协议》</text>
        <text class="agreement-plain">和</text>
        <text class="agreement-link" catchtap="openAgreement" data-type="privacy">《隐私政策》</text>
      </view>
    </view>

    <button class="btn-wechat {{agreed ? '' : 'pending'}}" bindtap="handleStart" loading="{{loading}}">
      ❤️ 开始我们的故事
    </button>

    <text class="login-tip">您可以随时在「我的」中查阅协议全文或撤回隐私授权</text>

    <text class="login-skip" bindtap="handleSkip">暂不登录，先逛逛</text>
  </view>
</view>