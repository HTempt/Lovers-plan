.login-container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding: 0 60rpx;
  background: linear-gradient(180deg, #FFD5DC 0%, #FFF0F3 30%, #FFF8F8 100%);
}

.login-header {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding-top: 120rpx;
}

.logo-area {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.logo-heart {
  font-size: 120rpx;
  margin-bottom: 30rpx;
  animation: heartbeat 1.5s ease-in-out infinite;
}

@keyframes heartbeat {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.1); }
}

.logo-title {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--primary-dark);
  margin-bottom: 20rpx;
}

.logo-subtitle {
  font-size: 28rpx;
  color: var(--text-secondary);
  letter-spacing: 4rpx;
}

.login-features {
  display: flex;
  justify-content: space-around;
  padding: 60rpx 0;
}

.feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.feature-icon {
  font-size: 48rpx;
}

.feature-text {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.login-footer {
  padding-bottom: 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* ===== 协议勾选区域（默认未勾选，由用户主动选择） ===== */
.agreement-row {
  display: flex;
  align-items: flex-start;
  width: 100%;
  margin-bottom: 32rpx;
}

.agreement-row.shake {
  animation: agreement-shake 0.5s ease-in-out;
}

@keyframes agreement-shake {
  0%, 100% { transform: translateX(0); }
  20% { transform: translateX(-12rpx); }
  40% { transform: translateX(12rpx); }
  60% { transform: translateX(-8rpx); }
  80% { transform: translateX(8rpx); }
}

/* 复选框加大点击热区，方便用户勾选 */
.checkbox-wrap {
  padding: 6rpx 16rpx 20rpx 0;
  flex-shrink: 0;
}

.checkbox {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  border: 2rpx solid #C4C4C4;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  transition: background 0.2s, border-color 0.2s;
}

.checkbox.checked {
  background: var(--primary-color);
  border-color: var(--primary-color);
}

.checkbox-icon {
  font-size: 22rpx;
  line-height: 1;
  color: #FFFFFF;
  font-weight: 700;
}

.agreement-text {
  flex: 1;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--text-secondary);
}

.agreement-plain {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.agreement-link {
  font-size: 24rpx;
  color: #576B95;
}

.btn-wechat {
  width: 100%;
  height: 100rpx;
  background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
  color: white;
  font-size: 34rpx;
  font-weight: 500;
  border-radius: 50rpx;
  text-align: center;
  padding: 0;
  margin: 0;
  box-shadow: 0 8rpx 32rpx rgba(255, 107, 129, 0.3);
}

/* 未勾选同意时的弱化样式（仍可点击，点击后提示需先同意） */
.btn-wechat.pending {
  background: linear-gradient(135deg, #FFC7D1, #FFB3C1);
  box-shadow: none;
}

.btn-icon {
  font-size: 40rpx;
}

.login-tip {
  font-size: 22rpx;
  color: var(--text-light);
  margin-top: 28rpx;
  text-align: center;
  line-height: 1.6;
}

/* 暂不登录入口：明确告知用户可以不登录直接浏览 */
.login-skip {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-top: 36rpx;
  padding: 16rpx 40rpx;
  text-decoration: underline;
}

.login-skip:active {
  opacity: 0.6;
}
