<view class="profile-container">
  <!-- 游客态：未登录不请求数据，协议与隐私政策始终可查阅 -->
  <view class="guest-state" wx:if="{{guest}}">
    <text class="guest-icon">💕</text>
    <text class="guest-title">还没有登录</text>
    <text class="guest-desc">登录后可以设置昵称头像、绑定另一半，并查看你们的恋爱数据。浏览无需登录。</text>
    <button class="btn-primary" bindtap="handleLogin">登录 / 注册</button>
    <text class="guest-later" bindtap="goHome">先回首页逛逛</text>
    <view class="guest-legal">
      <text class="guest-legal-link" bindtap="openAgreement" data-type="user">《用户服务协议》</text>
      <text class="guest-legal-link" bindtap="openAgreement" data-type="privacy">《隐私政策》</text>
    </view>
  </view>

  <view class="loading-wrap" wx:elif="{{loading}}">
    <text class="loading-text">加载中...</text>
  </view>

  <view class="profile-content" wx:else>
    <!-- ===== 用户信息 + 伴侣卡片 ===== -->
    <view class="top-section">
      <view class="user-row">
        <view class="avatar-section" bindtap="changeAvatar">
          <image class="avatar" src="{{userInfo.avatar || '/images/icon/user-girl.png'}}" />
          <view class="avatar-overlay">
            <text class="avatar-overlay-text">换</text>
          </view>
        </view>
        <view class="user-info">
          <view class="user-name-row">
            <text class="nickname">{{userInfo.nickname || '未设置昵称'}}</text>
            <text class="edit-nickname" bindtap="editNickname">修改 ›</text>
          </view>
          <view class="user-meta">
            <text class="user-meta-item" bindtap="editGender">{{genderText}}</text>
            <text class="user-meta-item" bindtap="editPhone">{{userInfo.phone || '绑定手机号（选填）'}}</text>
          </view>
        </view>
      </view>

      <!-- 伴侣卡片 -->
      <view class="partner-card" wx:if="{{coupleInfo}}" bindtap="showPartnerInfo">
        <view class="partner-avatar-wrap">
          <image class="partner-avatar" src="{{coupleInfo.partnerAvatar || '/images/icon/user-girl.png'}}" />
        </view>
        <view class="partner-info">
          <text class="partner-label">💕 我的另一半</text>
          <text class="partner-name">{{coupleInfo.partnerNickname || '未知'}}</text>
        </view>
        <text class="partner-arrow">›</text>
      </view>
    </view>

    <view class="grid-section">
      <view class="grid">
        <view class="grid-item" wx:for="{{gridItems}}" wx:key="key"
              bindtap="goToPage" data-page="{{item.key}}">
          <text class="grid-icon">{{item.icon}}</text>
          <text class="grid-label">{{item.name}}</text>
          <text class="grid-desc">{{item.desc}}</text>
        </view>
      </view>
    </view>

    <!-- ===== 协议与隐私 ===== -->
    <view class="legal-section">
      <view class="legal-row" bindtap="openAgreement" data-type="user">
        <text class="legal-label">《用户服务协议》</text>
        <text class="legal-arrow">›</text>
      </view>
      <view class="legal-row" bindtap="openAgreement" data-type="privacy">
        <text class="legal-label">《隐私政策》</text>
        <text class="legal-arrow">›</text>
      </view>
      <view class="legal-row" bindtap="withdrawConsent">
        <text class="legal-label legal-danger">撤回隐私授权</text>
        <text class="legal-arrow">›</text>
      </view>
    </view>

    <!-- ===== 操作按钮 ===== -->
    <view class="action-section">
      <button class="btn-unbind" bindtap="handleUnbind">解除情侣绑定</button>
      <button class="btn-logout" bindtap="handleLogout">退出登录</button>
    </view>
  </view>
</view>
